{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "properties": {
    "summary": {"type":"string"},
    "tracks": {"type":"array","items": {
      "type":"object","additionalProperties":false,
      "properties": {
        "id":{"type":"string"}, "label":{"type":"string"},
        "description":{"type":"string"},
        "first_sample":{"type":"integer"},"last_sample":{"type":"integer"},
        "seeds":{"type":"array","items":{
          "type":"object","additionalProperties":false,
          "properties":{
            "sample_index":{"type":"integer"},"timestamp_s":{"type":"number"},
            "box_xyxy_1000":{"type":"array","items":{"type":"number"},"minItems":4,"maxItems":4},
            "reason":{"type":"string"}
          },
          "required":["sample_index","timestamp_s","box_xyxy_1000","reason"]
        }},
        "uncertainties":{"type":"array","items":{"type":"string"}}
      },
      "required":["id","label","description","first_sample","last_sample","seeds","uncertainties"]
    }},
    "actions":{"type":"array","items":{
      "type":"object","additionalProperties":false,
      "properties":{
        "description":{"type":"string"},"participant_track_ids":{"type":"array","items":{"type":"string"}},
        "evidence_samples":{"type":"array","items":{"type":"integer"}},
        "uncertainties":{"type":"array","items":{"type":"string"}}
      },
      "required":["description","participant_track_ids","evidence_samples","uncertainties"]
    }},
    "uncertainties":{"type":"array","items":{"type":"string"}}
  },
  "required":["summary","tracks","actions","uncertainties"]
}
